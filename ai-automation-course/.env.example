# Settings for the course. Copy this file to .env and fill it in. Never commit .env.
#
# There are no keys for Google: on Cloud Run everything signs in as the
# automations service account, including the model (Gemini on Vertex AI).
# The secrets below belong to other companies, so deploy.sh puts them in
# Secret Manager. They never go in the code.

# Your Google Cloud project id, and the region everything runs in.
PROJECT=
REGION=europe-west2

# The model, and the region it runs in. Check the model is offered in that region.
GEMINI_MODEL=gemini-3.8-flash
VERTEX_LOCATION=europe-west1

# The Google Sheet with "Prospects" and "Leads" tabs. Share it with the service account as Editor.
# The id is the long part of the sheet's address.
SHEET_ID=

# Shadow mode: true does all the work and sends nothing. Set false to go live.
SHADOW=true

# The address speed to lead emails from, on a domain you've verified in Resend.
EMAIL_FROM=

# Secrets. deploy.sh copies each one into Secret Manager.
# 03_webhook checks this token. Make up a long random value.
WEBHOOK_TOKEN=
# 05_speed_to_lead checks requests are signed with this. Make up a long random value.
WEBHOOK_SECRET=
# A Slack incoming webhook address: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=
# An API key from resend.com.
RESEND_API_KEY=

# Optional: where tools/send_lead.py sends the test proposal. Use your own address.
TEST_LEAD_EMAIL=
