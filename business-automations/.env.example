# Settings for the examples. Copy this file to .env and fill it in.
# There are no API keys: on Cloud Run everything signs in as the service account.

# Your Google Cloud project id. The control panel in ui/ uses it.
PROJECT=

# The Google Sheet the examples read and write. Share it with the service account as Editor.
# The id is the long part of the sheet's address.
SHEET_ID=

# Checked by the two webhook examples, in the X-Token header. Make up a long random value.
WEBHOOK_TOKEN=change-me

# Drive folders for the receipts and video examples. Share each with the service account as Editor.
# The id is the last part of the folder's address.
RECEIPTS_FOLDER_ID=
VIDEOS_FOLDER_ID=

# Optional: a Slack incoming webhook address. Speed to lead posts to it when an enquiry arrives.
SLACK_WEBHOOK_URL=

# The model every example calls, on Vertex AI.
GEMINI_MODEL=gemini-3.8-flash
