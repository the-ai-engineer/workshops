# Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Protects the /run endpoints. Cloud Scheduler and your CRM send it as the X-Token header.
AUTOMATION_TOKEN=change-me

# Locally: the path to a service account key. On Cloud Run, leave it unset: the service's own account is used.
GOOGLE_APPLICATION_CREDENTIALS=service-account.json

# Invoice inbox: share both folders and the sheet with the service account's email
INBOX_FOLDER_ID=
PROCESSED_FOLDER_ID=
INVOICES_SHEET_ID=

# Client folders: the parent folder for every client, and the sheet that lists clients
CLIENTS_FOLDER_ID=
CLIENTS_SHEET_ID=

# Meeting reminders: share the calendar with the service account ("See all event details")
CALENDAR_ID=
OWN_DOMAIN=yourbusiness.com
TIMEZONE=Europe/London
SMTP_USER=
SMTP_PASSWORD=

# Step-by-step examples in src/: one Drive folder per example, each shared with the service account.
# They also use CLIENTS_FOLDER_ID, and CLIENTS_SHEET_ID with Leads, Contracts, Call notes, Transcripts and Content tabs.
# Gemini runs on Vertex AI as the service account, so there is no API key.
# The Google Sheet the course examples in examples/ read and write. Share it with the service account as Editor.
SHEET_ID=
GEMINI_MODEL=gemini-3.8-flash
LEADS_QUERY=recruitment companies in South Wales
LEADS_PER_RUN=10
RECEIPTS_FOLDER_ID=
# Optional: a Slack incoming webhook address. Speed to lead posts to it when an enquiry arrives.
SLACK_WEBHOOK_URL=
CONTRACTS_INBOX_ID=
RECORDINGS_FOLDER_ID=
VIDEOS_FOLDER_ID=
# The webhook example checks this in the X-Token header. Make up a long random value.
WEBHOOK_TOKEN=change-me

# Meeting follow-up: the Zoom webhook app's secret token. Uses CALENDAR_ID, OWN_DOMAIN,
# the Meetings tab in CLIENTS_SHEET_ID, and SMTP_USER/SMTP_PASSWORD to save Gmail drafts.
ZOOM_WEBHOOK_SECRET=
OWNER_NAME=
FOLLOW_UP_PROMISE=I'll follow up with the proposal in the next 48 hours.
