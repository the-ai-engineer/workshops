# Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Protects the /run endpoints. Cloud Scheduler and your CRM send it as the X-Token header.
AUTOMATION_TOKEN=change-me

# Locally: the path to a service account key. On Cloud Run, leave it unset: the service's own account is used.
GOOGLE_APPLICATION_CREDENTIALS=service-account.json

# Invoice inbox: share both folders and the sheet with the service account's email
INBOX_FOLDER_ID=
PROCESSED_FOLDER_ID=
INVOICES_SHEET_ID=

# Client folders: the parent folder for every client, and the sheet that lists clients
CLIENTS_FOLDER_ID=
CLIENTS_SHEET_ID=

# Meeting reminders: share the calendar with the service account ("See all event details")
CALENDAR_ID=
OWN_DOMAIN=yourbusiness.com
TIMEZONE=Europe/London
SMTP_USER=
SMTP_PASSWORD=

# Meeting follow-up: the Zoom webhook app's secret token. Uses CALENDAR_ID, OWN_DOMAIN,
# the Meetings tab in CLIENTS_SHEET_ID, and SMTP_USER/SMTP_PASSWORD to save Gmail drafts.
ZOOM_WEBHOOK_SECRET=
OWNER_NAME=
FOLLOW_UP_PROMISE=I'll follow up with the proposal in the next 48 hours.
